{
  "manifest_version": 3,
  "name": "Playback Presets for Submeta",
  "version": "0.4.1",
  "description": "비공식 Submeta 보조 확장: 배속·자막 설정 유지, 영상 구간 GIF 생성 및 저장.",
  "browser_specific_settings": {
    "gecko": {
      "id": "playback-preset@submeta.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://submeta.io/*",
    "https://iframe.cloudflarestream.com/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "gif/native-folder.js",
      "gif/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://submeta.io/*"
      ],
      "js": [
        "shared.js",
        "ui/tokens.js",
        "ui/primitives.js",
        "ui/react-runtime.js",
        "ui/playback-settings.js",
        "panel.js",
        "ui/gif-editor.js",
        "gif/launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://iframe.cloudflarestream.com/*"
      ],
      "js": [
        "shared.js",
        "player.js",
        "gif/config.js",
        "gif/encoder-client.js",
        "gif/capture.js",
        "gif/save.js",
        "gif/timeline.js",
        "ui/tokens.js",
        "ui/primitives.js",
        "ui/react-runtime.js",
        "ui/gif-editor.js",
        "gif/panel.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "author": "aebongbong",
  "web_accessible_resources": [
    {
      "resources": [
        "gif/encoder.html"
      ],
      "matches": [
        "https://iframe.cloudflarestream.com/*"
      ]
    }
  ]
}
