{
  "name": "submeta-playback-preset",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node tests/extension.test.mjs && node tests/player.test.mjs",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "test:install": "playwright install chromium",
    "lint:extension": "web-ext lint --source-dir extension --warnings-as-errors",
    "package:release": "python3 scripts/package_release.py",
    "capture:listing": "playwright test -c playwright.listing.config.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "web-ext": "10.6.0"
  },
  "author": "aebongbong",
  "license": "MIT"
}
